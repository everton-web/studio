Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# HTTPS sempre.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Pastas sempre com barra final (o export usa trailingSlash e o design-system
# do relatório carrega imagens por caminho relativo).
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

<IfModule mod_headers.c>
  # HTML e o PHP sempre revalidam; assets com hash recebem cache longo em _next/static/.
  <FilesMatch "\.(?:html|php|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|gif|svg|webp|avif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Segredos do formulário ficam em ../form-config.php (fora do public_html).
# Nunca grave valores reais neste arquivo.
